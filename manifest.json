{
  "manifest_version": 3,
  "name": "YT Music Transpose",
  "version": "1.0.0",
  "description": "YouTube Music에서 재생 중인 곡의 키를 템포 변화 없이 반음 단위로 올리고 내립니다.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://music.youtube.com/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "YT Music Transpose",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["src/key-detect.js", "src/content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/pitch-worklet.js"],
      "matches": ["https://music.youtube.com/*"]
    }
  ],
  "commands": {
    "transpose-up": {
      "suggested_key": { "default": "Alt+Up" },
      "description": "키 반음 올리기"
    },
    "transpose-down": {
      "suggested_key": { "default": "Alt+Down" },
      "description": "키 반음 내리기"
    },
    "transpose-reset": {
      "suggested_key": { "default": "Alt+0" },
      "description": "원래 키로 (0)"
    }
  }
}
